{
  "name": "visual-engineering-suite",
  "version": "1.0.0",
  "description": "Production-quality, cross-agent visual engineering skill suite for AI coding agents",
  "type": "module",
  "bin": {
    "ves-env": "./bin/ves-env.js",
    "ves-validate": "./bin/ves-validate.js",
    "ves-dimension": "./bin/ves-dimension.js",
    "ves-diff": "./bin/ves-diff.js",
    "ves-screenshot": "./bin/ves-screenshot.js",
    "ves-refine": "./bin/ves-refine.js",
    "ves-doctor": "./bin/ves-doctor.js",
    "ves-pack": "./bin/ves-pack.js",
    "ves-benchmark": "./bin/ves-benchmark.js"
  },
  "scripts": {
    "test": "node --test tests/**/*.test.js",
    "validate": "node bin/ves-validate.js",
    "check-env": "node bin/ves-env.js",
    "check-health": "node bin/ves-doctor.js",
    "doctor": "node bin/ves-doctor.js",
    "pack": "node bin/ves-pack.js",
    "refine": "node bin/ves-refine.js",
    "benchmark": "node bin/ves-benchmark.js",
    "benchmark:visual": "node bin/ves-benchmark.js --mode visual",
    "benchmark:functional": "node bin/ves-benchmark.js --mode functional",
    "benchmark:validate": "node bin/ves-benchmark.js --mode validate",
    "build:site": "node scripts/build-site-data.js && vite build",
    "dev:site": "node scripts/build-site-data.js && vite",
    "serve:site": "vite preview"
  },
  "keywords": [
    "agent-skills",
    "antigravity",
    "claude-code",
    "cursor",
    "visual-engineering",
    "visual-regression",
    "design-system",
    "frontend",
    "qa",
    "accessibility"
  ],
  "author": "Visual Engineering Suite Contributors",
  "license": "MIT",
  "dependencies": {
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "vite": "^8.3.4"
  },
  "optionalDependencies": {
    "playwright": "^1.40.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
